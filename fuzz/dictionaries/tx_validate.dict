# Transaction validation dictionary for libFuzzer
# Versions (u32 little-endian)
ver_1="\x01\x00\x00\x00"
ver_2="\x02\x00\x00\x00"

# Segwit marker and flag
segwit_marker="\x00\x01"

# Coinbase previous outpoint
prevout_coinbase_hash="\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
prevout_coinbase_index="\xff\xff\xff\xff"

# Sequence numbers (u32 little-endian)
seq_final="\xff\xff\xff\xff"
seq_locktime_enabled="\xfe\xff\xff\xff"
seq_rbf="\xfd\xff\xff\xff"
seq_zero="\x00\x00\x00\x00"
seq_disable_relative_locktime="\x00\x00\x00\x80"

# Locktimes (u32 little-endian)
locktime_zero="\x00\x00\x00\x00"
locktime_timestamp_threshold="\x00\x65\xcd\x1d"

# Script prefixes / templates
op_return="\x6a"
p2pkh_prefix="\x76\xa9\x14"
p2pkh_suffix="\x88\xac"
p2sh_prefix="\xa9\x14"
p2wpkh_prefix="\x00\x14"
p2wsh_prefix="\x00\x20"
p2tr_prefix="\x51\x20"

# Amounts (satoshis, u64 little-endian)
amt_0="\x00\x00\x00\x00\x00\x00\x00\x00"
amt_1="\x01\x00\x00\x00\x00\x00\x00\x00"
amt_50btc="\x00\xf2\x05\x2a\x01\x00\x00\x00"
amt_21m="\x00\x40\x07\x5a\xf0\x75\x07\x00"

# CompactSize boundaries
varint_0="\x00"
varint_fc="\xfc"
varint_fd="\xfd\xfd\x00"
varint_fe="\xfe\x00\x00\x01\x00"
varint_ff="\xff\x00\x00\x00\x00\x01\x00\x00\x00"
