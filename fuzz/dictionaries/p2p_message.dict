# P2P wire message dictionary for libFuzzer
# Network magic bytes
magic_mainnet="\xf9\xbe\xb4\xd9"
magic_testnet3="\x0b\x11\x09\x07"
magic_testnet4="\x1c\x16\x3f\x28"
magic_regtest="\xfa\xbf\xb5\xda"
magic_signet="\x0a\x03\xcf\x40"

# 12-byte null-padded P2P command headers
cmd_version_padded="version\x00\x00\x00\x00\x00"
cmd_verack_padded="verack\x00\x00\x00\x00\x00\x00"
cmd_addr_padded="addr\x00\x00\x00\x00\x00\x00\x00\x00"
cmd_addrv2_padded="addrv2\x00\x00\x00\x00\x00\x00"
cmd_inv_padded="inv\x00\x00\x00\x00\x00\x00\x00\x00\x00"
cmd_getdata_padded="getdata\x00\x00\x00\x00\x00"
cmd_notfound_padded="notfound\x00\x00\x00\x00"
cmd_getblocks_padded="getblocks\x00\x00\x00"
cmd_getheaders_padded="getheaders\x00\x00"
cmd_tx_padded="tx\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
cmd_headers_padded="headers\x00\x00\x00\x00\x00"
cmd_block_padded="block\x00\x00\x00\x00\x00\x00\x00"
cmd_blocktxn_padded="blocktxn\x00\x00\x00\x00"
cmd_getblocktxn_padded="getblocktxn\x00"
cmd_cmpctblock_padded="cmpctblock\x00\x00"
cmd_getaddr_padded="getaddr\x00\x00\x00\x00\x00"
cmd_mempool_padded="mempool\x00\x00\x00\x00\x00"
cmd_ping_padded="ping\x00\x00\x00\x00\x00\x00\x00\x00"
cmd_pong_padded="pong\x00\x00\x00\x00\x00\x00\x00\x00"
cmd_merkleblock_padded="merkleblock\x00"
cmd_filterload_padded="filterload\x00\x00"
cmd_filteradd_padded="filteradd\x00\x00\x00"
cmd_filterclear_padded="filterclear\x00"
cmd_feefilter_padded="feefilter\x00\x00\x00"
cmd_sendheaders_padded="sendheaders\x00"
cmd_sendcmpct_padded="sendcmpct\x00\x00\x00"
cmd_sendaddrv2_padded="sendaddrv2\x00\x00"
cmd_wtxidrelay_padded="wtxidrelay\x00\x00"
cmd_cfilter_padded="cfilter\x00\x00\x00\x00\x00"
cmd_cfheaders_padded="cfheaders\x00\x00\x00"
cmd_cfcheckpt_padded="cfcheckpt\x00\x00\x00"
cmd_getcfilters_padded="getcfilters\x00"
cmd_getcfheaders_padded="getcfheaders"
cmd_getcfcheckpt_padded="getcfcheckpt"

# Unpadded command strings
"version"
"verack"
"addr"
"addrv2"
"inv"
"getdata"
"notfound"
"getblocks"
"getheaders"
"tx"
"headers"
"block"
"blocktxn"
"getblocktxn"
"cmpctblock"
"getaddr"
"mempool"
"ping"
"pong"
"merkleblock"
"filterload"
"filteradd"
"filterclear"
"feefilter"
"sendheaders"
"sendcmpct"
"sendaddrv2"
"wtxidrelay"
"cfilter"
"cfheaders"
"cfcheckpt"

# Inventory types (u32 little-endian)
inv_tx="\x01\x00\x00\x00"
inv_block="\x02\x00\x00\x00"
inv_filtered_block="\x03\x00\x00\x00"
inv_cmpct_block="\x04\x00\x00\x00"
inv_witness_tx="\x01\x00\x00\x40"
inv_witness_block="\x02\x00\x00\x40"

# Protocol versions
ver_70016="\x70\x11\x01\x00"
ver_70015="\x6f\x11\x01\x00"
ver_70001="\x61\x11\x01\x00"

# Service flags (u64 little-endian)
srv_node_network="\x01\x00\x00\x00\x00\x00\x00\x00"
srv_node_witness="\x08\x00\x00\x00\x00\x00\x00\x00"
srv_node_compact_filters="\x40\x00\x00\x00\x00\x00\x00\x00"
srv_node_p2p_v2="\x00\x08\x00\x00\x00\x00\x00\x00"

# CompactSize / VarInt boundaries
varint_0="\x00"
varint_fc="\xfc"
varint_fd="\xfd\xfd\x00"
varint_fe="\xfe\x00\x00\x01\x00"
varint_ff="\xff\x00\x00\x00\x00\x01\x00\x00\x00"
