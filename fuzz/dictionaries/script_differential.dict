# Script differential dictionary for libFuzzer
# Constants and Push values
op_0="\x00"
op_1negate="\x4f"
op_1="\x51"
op_2="\x52"
op_3="\x53"
op_16="\x60"

# Control flow opcodes
op_nop="\x61"
op_if="\x63"
op_notif="\x64"
op_else="\x67"
op_endif="\x68"
op_verify="\x69"
op_return="\x6a"

# Stack manipulation
op_toaltstack="\x6b"
op_fromaltstack="\x6c"
op_2drop="\x6d"
op_2dup="\x6e"
op_3dup="\x6f"
op_2over="\x70"
op_2rot="\x71"
op_2swap="\x72"
op_ifdup="\x73"
op_depth="\x74"
op_drop="\x75"
op_dup="\x76"
op_nip="\x77"
op_over="\x78"
op_pick="\x79"
op_roll="\x7a"
op_rot="\x7b"
op_swap="\x7c"
op_tuck="\x7d"

# Splice and comparison
op_size="\x82"
op_equal="\x87"
op_equalverify="\x88"

# Arithmetic
op_1add="\x8b"
op_1sub="\x8c"
op_negate="\x8f"
op_abs="\x90"
op_not="\x91"
op_0notequal="\x92"
op_add="\x93"
op_sub="\x94"
op_booland="\x9a"
op_boolor="\x9b"
op_numequal="\x9c"
op_numequalverify="\x9d"
op_numnotequal="\x9e"
op_lessthan="\x9f"
op_greaterthan="\xa0"
op_lessthanorequal="\xa1"
op_greaterthanorequal="\xa2"
op_min="\xa3"
op_max="\xa4"
op_within="\xa5"

# Cryptography
op_ripemd160="\xa6"
op_sha1="\xa7"
op_sha256="\xa8"
op_hash160="\xa9"
op_hash256="\xaa"
op_codeseparator="\xab"
op_checksig="\xac"
op_checksigverify="\xad"
op_checkmultisig="\xae"
op_checkmultisigverify="\xaf"
op_checksigadd="\xba"

# Locktime
op_checklocktimeverify="\xb1"
op_checksequenceverify="\xb2"

# Segwit and Taproot patterns
tapscript_leaf_v0="\xc0"
taproot_annex="\x50"
p2wpkh_prefix="\x00\x14"
p2wsh_prefix="\x00\x20"
p2tr_prefix="\x51\x20"
p2sh_prefix="\xa9\x14"
p2pkh_prefix="\x76\xa9\x14"
p2pkh_suffix="\x88\xac"

# Sighash types
sighash_all="\x01"
sighash_none="\x02"
sighash_single="\x03"
sighash_anyonecanpay="\x80"
sighash_all_anyonecanpay="\x81"
sighash_none_anyonecanpay="\x82"
sighash_single_anyonecanpay="\x83"
sighash_default="\x00"

# CompactSize boundaries
varint_0="\x00"
varint_fc="\xfc"
varint_fd="\xfd\xfd\x00"
varint_fe="\xfe\x00\x00\x01\x00"
varint_ff="\xff\x00\x00\x00\x00\x01\x00\x00\x00"
