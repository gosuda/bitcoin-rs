# Selects the matching bitcoin-rs and BIP300/301 enforcer network.
BITCOIN_RS_NETWORK=betanet

# JSON-RPC is published to 127.0.0.1 on the Docker host. These are the
# Network::Betanet default ports (RPC 8532, P2P 8533).
BITCOIN_RS_RPC_PORT=8532
BITCOIN_RS_RPC_USER=
BITCOIN_RS_RPC_PASSWORD=

# P2P is published on all Docker host interfaces so other nodes can connect.
BITCOIN_RS_P2P_PORT=8533

# The enforcer's mempool mode requires node txindex=1; leave this on.
BITCOIN_RS_TXINDEX=true
BITCOIN_RS_ELECTRUM_BIND=

# Runtime tracing filter.
BITCOIN_RS_LOG_LEVEL=info

ENFORCER_GRPC_PORT=50051
ENFORCER_RPC_PORT=8122
